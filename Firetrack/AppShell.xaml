<?xml version="1.0" encoding="UTF-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:views="clr-namespace:Firetrack.Views"
       x:Class="Firetrack.AppShell"
       x:Name="MyShell">

    <Shell.FlyoutHeader>
        <VerticalStackLayout BackgroundColor="{StaticResource PrimaryColor}"
                             Padding="20"
                             Spacing="5">
            <Image Source="logo.jpg"
                   WidthRequest="80"
                   HeightRequest="80"
                   HorizontalOptions="Center"
                   Aspect="AspectFit" />
            <Label Text="Fire Track"
                   FontSize="20"
                   FontAttributes="Bold"
                   TextColor="White"
                   HorizontalOptions="Center" />
            <Label Text="BFP Cebu City Station"
                   FontSize="14"
                   TextColor="#E0E0E0"
                   HorizontalOptions="Center" />
        </VerticalStackLayout>
    </Shell.FlyoutHeader>

    <!-- ===== GLOBAL TITLE VIEW (with Clicked events) ===== -->
    <Shell.TitleView>
        <Grid x:Name="TitleViewGrid"
              ColumnDefinitions="Auto, *, Auto"
              Padding="5,0"
              ColumnSpacing="5"
              HeightRequest="44">

            <!-- ✅ Back Button – uses Clicked event -->
            <Button Grid.Column="0"
                    Text="‹"
                    Clicked="OnBackClicked"
                    BackgroundColor="Transparent"
                    TextColor="{StaticResource OnBackground}"
                    FontSize="28"
                    FontAttributes="Bold"
                    VerticalOptions="Center"
                    HorizontalOptions="Start"
                    IsVisible="{Binding IsBackVisible}"
                    WidthRequest="44" />

            <!-- Empty Title placeholder -->
            <Label Grid.Column="1"
                   Text=""
                   VerticalOptions="Center"
                   HorizontalOptions="Center" />

            <!-- ✅ Logout Button – uses Clicked event -->
            <Button Grid.Column="2"
                    Text="🚪"
                    Clicked="OnLogoutClicked"
                    BackgroundColor="Transparent"
                    TextColor="{StaticResource DangerColor}"
                    FontSize="20"
                    VerticalOptions="Center"
                    HorizontalOptions="End" />
        </Grid>
    </Shell.TitleView>

    <!-- HIDDEN PAGES (not in flyout) -->
    <ShellContent Title="Login"
                  ContentTemplate="{DataTemplate views:LoginPage}"
                  Route="LoginPage"
                  Shell.FlyoutItemIsVisible="False" />
    <ShellContent Title="ForgotPassword"
                  ContentTemplate="{DataTemplate views:ForgotPasswordPage}"
                  Route="ForgotPasswordPage"
                  Shell.FlyoutItemIsVisible="False" />
    <ShellContent Title="Notifications"
                  ContentTemplate="{DataTemplate views:NotificationsPage}"
                  Route="NotificationsPage"
                  Shell.FlyoutItemIsVisible="False" />
    <ShellContent Title="Equipment Detail"
                  ContentTemplate="{DataTemplate views:EquipmentDetailPage}"
                  Route="EquipmentDetailPage"
                  Shell.FlyoutItemIsVisible="False" />
    <ShellContent Title="Equipment Request Detail"
                  ContentTemplate="{DataTemplate views:EquipmentRequestDetailPage}"
                  Route="EquipmentRequestDetailPage"
                  Shell.FlyoutItemIsVisible="False" />
    <ShellContent Title="Report Damage"
                  ContentTemplate="{DataTemplate views:ReportDamagePage}"
                  Route="ReportDamagePage"
                  Shell.FlyoutItemIsVisible="False" />
    <ShellContent Title="ICS"
                  ContentTemplate="{DataTemplate views:IcsPage}"
                  Route="IcsPage"
                  Shell.FlyoutItemIsVisible="False" />
    <ShellContent Title="Category Items"
                  ContentTemplate="{DataTemplate views:CategoryItemsPage}"
                  Route="CategoryItemsPage"
                  Shell.FlyoutItemIsVisible="False" />
    <ShellContent Title="Transaction History"
                  ContentTemplate="{DataTemplate views:TransactionHistoryPage}"
                  Route="TransactionHistoryPage"
                  Shell.FlyoutItemIsVisible="False" />
    <ShellContent Title="Audit Log"
                  ContentTemplate="{DataTemplate views:AuditLogPage}"
                  Route="AuditLogPage"
                  Shell.FlyoutItemIsVisible="False" />
    <ShellContent Title="Disposal Requests"
                  ContentTemplate="{DataTemplate views:DisposalRequestsPage}"
                  Route="DisposalRequestsPage"
                  Shell.FlyoutItemIsVisible="False" />
    <ShellContent Title="Add Equipment"
                  ContentTemplate="{DataTemplate views:AddEquipmentPage}"
                  Route="AddEquipmentPage"
                  Shell.FlyoutItemIsVisible="False" />

    <!-- ADMIN FLYOUT -->
    <FlyoutItem Title="Admin"
                FlyoutDisplayOptions="AsMultipleItems"
                IsVisible="{Binding IsAdmin}">
        <ShellContent Title="Dashboard" 
                  ContentTemplate="{DataTemplate views:DashboardPage}" 
                  Route="AdminDashboard" />
        <ShellContent Title="Inventory" ContentTemplate="{DataTemplate views:EquipmentCategoryPage}" Route="EquipmentCategoryPage" />
        <ShellContent Title="Transfer" ContentTemplate="{DataTemplate views:TransferPage}" Route="TransferPage" />
        <ShellContent Title="Clearance" ContentTemplate="{DataTemplate views:ClearancePage}" Route="ClearancePage" />
        <ShellContent Title="User Management" ContentTemplate="{DataTemplate views:UserManagementPage}" Route="UserManagementPage" />
        <ShellContent Title="Pending Requests" ContentTemplate="{DataTemplate views:PendingRequestsPage}" Route="PendingRequestsPage" />
        <ShellContent Title="Disposal Requests" ContentTemplate="{DataTemplate views:DisposalRequestsPage}" Route="DisposalRequestsPage" />
        <ShellContent Title="Scanner" ContentTemplate="{DataTemplate views:ScannerPage}" Route="ScannerPage" />
        <ShellContent Title="Audit Log" ContentTemplate="{DataTemplate views:AuditLogPage}" Route="AuditLogPage" />
    </FlyoutItem>

    <!-- PERSONNEL FLYOUT -->
    <FlyoutItem Title="Personnel"
                FlyoutDisplayOptions="AsMultipleItems"
                IsVisible="{Binding IsPersonnel}">
        <ShellContent Title="Dashboard" 
                  ContentTemplate="{DataTemplate views:DashboardPage}" 
                  Route="PersonnelDashboard" />
        <ShellContent Title="Request Equipment" ContentTemplate="{DataTemplate views:EquipmentCategoryPage}" Route="EquipmentCategoryPage" />
        <ShellContent Title="Profile" ContentTemplate="{DataTemplate views:ProfilePage}" Route="ProfilePage" />
        <ShellContent Title="Notifications" ContentTemplate="{DataTemplate views:NotificationsPage}" Route="NotificationsPage" />
        <ShellContent Title="Scanner" ContentTemplate="{DataTemplate views:ScannerPage}" Route="ScannerPage" />
    </FlyoutItem>

    <!-- FOOTER -->
    <Shell.FlyoutFooter>
        <VerticalStackLayout Spacing="10" Padding="15,10">
            <Label Text="Fire Track v1.0"
                   FontSize="12"
                   TextColor="{StaticResource Gray300}"
                   HorizontalOptions="Center" />
        </VerticalStackLayout>
    </Shell.FlyoutFooter>
</Shell>