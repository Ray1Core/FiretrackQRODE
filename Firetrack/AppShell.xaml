<?xml version="1.0" encoding="UTF-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:views="clr-namespace:Firetrack.Views"
       x:Class="Firetrack.AppShell"
       x:Name="MyShell"
       Shell.BackgroundColor="{StaticResource PrimaryColor}"
       Shell.ForegroundColor="White"
       Shell.TitleColor="White"
       Shell.DisabledColor="#80FFFFFF"
       Shell.UnselectedColor="#B0FFFFFF">

    <Shell.FlyoutHeader>
        <VerticalStackLayout BackgroundColor="{StaticResource PrimaryColor}"
                             Padding="20"
                             Spacing="5">
            <Image Source="logo.jpg"
                   WidthRequest="80"
                   HeightRequest="80"
                   HorizontalOptions="Center"
                   Aspect="AspectFit" />
            <Label Text="Fire Track"
                   FontSize="20"
                   FontAttributes="Bold"
                   TextColor="White"
                   HorizontalOptions="Center" />
            <Label Text="BFP Cebu City Station"
                   FontSize="14"
                   TextColor="#E0E0E0"
                   HorizontalOptions="Center" />
        </VerticalStackLayout>
    </Shell.FlyoutHeader>

    <!-- ===== GLOBAL TITLE VIEW (Logout button) ===== -->
    <Shell.TitleView>
        <Grid x:Name="TitleViewGrid"
              ColumnDefinitions="*, Auto"
              Padding="5,0"
              ColumnSpacing="5"
              HeightRequest="44">
            <Label Grid.Column="0"
                   Text=""
                   VerticalOptions="Center"
                   HorizontalOptions="Center" />
            <Button Grid.Column="1"
                    Text="Logout"
                    Clicked="OnLogoutClicked"
                    BackgroundColor="Transparent"
                    TextColor="White"
                    FontSize="16"
                    FontAttributes="Bold"
                    Padding="10,0"
                    VerticalOptions="Center"
                    HorizontalOptions="End" />
        </Grid>
    </Shell.TitleView>

    <!-- ===== ROOT PAGES (Flyout accessible, absolute routes only) ===== -->
    <ShellContent Title="Login" ContentTemplate="{DataTemplate views:LoginPage}" Route="LoginPage" Shell.FlyoutItemIsVisible="False" />
    <ShellContent Title="ForgotPassword" ContentTemplate="{DataTemplate views:ForgotPasswordPage}" Route="ForgotPasswordPage" Shell.FlyoutItemIsVisible="False" />

    <!-- ===== ADMIN FLYOUT ===== -->
    <FlyoutItem Title="Admin"
                FlyoutDisplayOptions="AsMultipleItems"
                IsVisible="{Binding IsAdmin}">
        <ShellContent Title="Dashboard" ContentTemplate="{DataTemplate views:DashboardPage}" Route="AdminDashboard" />
        <ShellContent Title="Inventory" ContentTemplate="{DataTemplate views:EquipmentCategoryPage}" Route="AdminEquipmentCategory" />
        <ShellContent Title="Transfer" ContentTemplate="{DataTemplate views:TransferPage}" Route="TransferPage" />
        <ShellContent Title="Clearance" ContentTemplate="{DataTemplate views:ClearancePage}" Route="ClearancePage" />
        <ShellContent Title="User Management" ContentTemplate="{DataTemplate views:UserManagementPage}" Route="UserManagementPage" />
        <ShellContent Title="Pending Requests" ContentTemplate="{DataTemplate views:PendingRequestsPage}" Route="PendingRequestsPage" />
        <ShellContent Title="Disposal Requests" ContentTemplate="{DataTemplate views:DisposalRequestsPage}" Route="DisposalRequestsPage" />
        <ShellContent Title="Scanner" ContentTemplate="{DataTemplate views:ScannerPage}" Route="AdminScanner" />
        <ShellContent Title="Audit Log" ContentTemplate="{DataTemplate views:AuditLogPage}" Route="AuditLogPage" />
        <ShellContent Title="PDF Archive" ContentTemplate="{DataTemplate views:PdfArchivePage}" Route="PdfArchivePage" />
    </FlyoutItem>

    <!-- ===== PERSONNEL FLYOUT ===== -->
    <FlyoutItem Title="Personnel"
                FlyoutDisplayOptions="AsMultipleItems"
                IsVisible="{Binding IsPersonnel}">
        <ShellContent Title="Dashboard" ContentTemplate="{DataTemplate views:DashboardPage}" Route="PersonnelDashboard" />
        <ShellContent Title="Request Equipment" ContentTemplate="{DataTemplate views:EquipmentCategoryPage}" Route="PersonnelEquipmentCategory" />
        <ShellContent Title="Profile" ContentTemplate="{DataTemplate views:ProfilePage}" Route="ProfilePage" />
        <ShellContent Title="Scanner" ContentTemplate="{DataTemplate views:ScannerPage}" Route="PersonnelScanner" />
    </FlyoutItem>

    <!-- ===== FOOTER ===== -->
    <Shell.FlyoutFooter>
        <VerticalStackLayout Spacing="10" Padding="15,10">
            <Label Text="Fire Track v1.0"
                   FontSize="12"
                   TextColor="{StaticResource Gray300}"
                   HorizontalOptions="Center" />
        </VerticalStackLayout>
    </Shell.FlyoutFooter>
</Shell>