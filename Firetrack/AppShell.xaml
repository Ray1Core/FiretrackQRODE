<?xml version="1.0" encoding="UTF-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:views="clr-namespace:Firetrack.Views"
       x:Class="Firetrack.AppShell"
       x:Name="MyShell">

    <!-- ===== FLYOUT HEADER with LOGO ===== -->
    <Shell.FlyoutHeader>
        <VerticalStackLayout BackgroundColor="{StaticResource PrimaryColor}"
                             Padding="20"
                             Spacing="5">
            <Image Source="logo.jpg"
                   WidthRequest="80"
                   HeightRequest="80"
                   HorizontalOptions="Center"
                   Aspect="AspectFit" />
            <Label Text="Fire Track"
                   FontSize="20"
                   FontAttributes="Bold"
                   TextColor="White"
                   HorizontalOptions="Center" />
            <Label Text="BFP Cebu City Station"
                   FontSize="14"
                   TextColor="#E0E0E0"
                   HorizontalOptions="Center" />
        </VerticalStackLayout>
    </Shell.FlyoutHeader>

    <!-- ===== GLOBAL TITLE VIEW (notification badge) ===== -->
    <Shell.TitleView>
        <Grid ColumnDefinitions="*, Auto" Padding="10,0">
            <Label Grid.Column="0" Text="" />
            <Button Grid.Column="1"
                    Text="{Binding NotificationBadgeText}"
                    Command="{Binding GoToNotificationsCommand}"
                    BackgroundColor="Transparent"
                    TextColor="{StaticResource OnBackground}"
                    FontSize="18"
                    VerticalOptions="Center"
                    HorizontalOptions="End" />
        </Grid>
    </Shell.TitleView>

    <!-- ===== HIDDEN PAGES (not in flyout) ===== -->
    <ShellContent Title="Login"
                  ContentTemplate="{DataTemplate views:LoginPage}"
                  Route="LoginPage"
                  Shell.FlyoutItemIsVisible="False" />

    <ShellContent Title="ForgotPassword"
                  ContentTemplate="{DataTemplate views:ForgotPasswordPage}"
                  Route="ForgotPasswordPage"
                  Shell.FlyoutItemIsVisible="False" />

    <ShellContent Title="Notifications"
                  ContentTemplate="{DataTemplate views:NotificationsPage}"
                  Route="NotificationsPage"
                  Shell.FlyoutItemIsVisible="False" />

    <ShellContent Title="Equipment Detail"
                  ContentTemplate="{DataTemplate views:EquipmentDetailPage}"
                  Route="EquipmentDetailPage"
                  Shell.FlyoutItemIsVisible="False" />

    <ShellContent Title="Equipment Request Detail"
                  ContentTemplate="{DataTemplate views:EquipmentRequestDetailPage}"
                  Route="EquipmentRequestDetailPage"
                  Shell.FlyoutItemIsVisible="False" />

    <ShellContent Title="Report Damage"
                  ContentTemplate="{DataTemplate views:ReportDamagePage}"
                  Route="ReportDamagePage"
                  Shell.FlyoutItemIsVisible="False" />

    <ShellContent Title="ICS"
                  ContentTemplate="{DataTemplate views:IcsPage}"
                  Route="IcsPage"
                  Shell.FlyoutItemIsVisible="False" />

    <ShellContent Title="Category Items"
                  ContentTemplate="{DataTemplate views:CategoryItemsPage}"
                  Route="CategoryItemsPage"
                  Shell.FlyoutItemIsVisible="False" />

    <!-- ===== ADMIN FLYOUT GROUP ===== -->
    <FlyoutItem Title="Admin"
                FlyoutDisplayOptions="AsMultipleItems"
                IsVisible="{Binding IsAdmin}">

        <ShellContent Title="Dashboard"
                      ContentTemplate="{DataTemplate views:DashboardPage}"
                      Route="DashboardPage" />

        <ShellContent Title="Inventory"
                      ContentTemplate="{DataTemplate views:EquipmentCategoryPage}"
                      Route="EquipmentCategoryPage" />

        <ShellContent Title="Transfer"
                      ContentTemplate="{DataTemplate views:TransferPage}"
                      Route="TransferPage" />

        <ShellContent Title="Clearance"
                      ContentTemplate="{DataTemplate views:ClearancePage}"
                      Route="ClearancePage" />

        <ShellContent Title="User Management"
                      ContentTemplate="{DataTemplate views:UserManagementPage}"
                      Route="UserManagementPage" />

        <ShellContent Title="Pending Requests"
                      ContentTemplate="{DataTemplate views:PendingRequestsPage}"
                      Route="PendingRequestsPage" />

        <ShellContent Title="Disposal Requests"
                      ContentTemplate="{DataTemplate views:DisposalRequestsPage}"
                      Route="DisposalRequestsPage" />

        <ShellContent Title="Scanner"
                      ContentTemplate="{DataTemplate views:ScannerPage}"
                      Route="ScannerPage" />

        <ShellContent Title="Audit Log"
                      ContentTemplate="{DataTemplate views:AuditLogPage}"
                      Route="AuditLogPage" />
    </FlyoutItem>

    <!-- ===== PERSONNEL FLYOUT GROUP ===== -->
    <FlyoutItem Title="Personnel"
                FlyoutDisplayOptions="AsMultipleItems"
                IsVisible="{Binding IsPersonnel}">

        <ShellContent Title="Dashboard"
                      ContentTemplate="{DataTemplate views:DashboardPage}"
                      Route="DashboardPage" />

        <ShellContent Title="Request Equipment"
                      ContentTemplate="{DataTemplate views:EquipmentCategoryPage}"
                      Route="EquipmentCategoryPage" />

        <ShellContent Title="Profile"
                      ContentTemplate="{DataTemplate views:ProfilePage}"
                      Route="ProfilePage" />

        <ShellContent Title="Notifications"
                      ContentTemplate="{DataTemplate views:NotificationsPage}"
                      Route="NotificationsPage" />

        <ShellContent Title="Transaction History"
                      ContentTemplate="{DataTemplate views:TransactionHistoryPage}"
                      Route="TransactionHistoryPage" />

        <ShellContent Title="Scanner"
                      ContentTemplate="{DataTemplate views:ScannerPage}"
                      Route="ScannerPage" />
    </FlyoutItem>

    <!-- ===== FLYOUT FOOTER with Logout ===== -->
    <Shell.FlyoutFooter>
        <VerticalStackLayout Spacing="10" Padding="15,10">
            <Button Text="Logout"
                    Command="{Binding LogoutCommand}"
                    BackgroundColor="{StaticResource DangerColor}"
                    TextColor="White"
                    CornerRadius="8"
                    HeightRequest="45"
                    FontAttributes="Bold" />
            <Label Text="Fire Track v1.0"
                   FontSize="12"
                   TextColor="{StaticResource Gray300}"
                   HorizontalOptions="Center" />
        </VerticalStackLayout>
    </Shell.FlyoutFooter>
</Shell>