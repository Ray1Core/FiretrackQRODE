<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- ========================================================== -->
    <!-- NEW PALETTE – BLUE THEME (from provided colors)            -->
    <!-- ========================================================== -->
    <!-- true-cobalt: #082A83 (Deep blue)                           -->
    <!-- black:       #000000                                       -->
    <!-- ocean-twilight: #4445B1 (Purple-blue)                     -->
    <!-- azure-blue:  #4183E1 (Bright blue)                        -->
    <!-- light-blue:  #ABCDD7 (Soft light blue)                    -->

    <!-- ===== BRAND COLORS ===== -->
    <Color x:Key="PrimaryColor">#4183E1</Color>
    <!-- Azure Blue - Main brand -->
    <Color x:Key="PrimaryColorDark">#082A83</Color>
    <!-- True Cobalt - Darker -->
    <Color x:Key="SecondaryColor">#4445B1</Color>
    <!-- Ocean Twilight - Secondary -->
    <Color x:Key="AccentColor">#ABCDD7</Color>
    <!-- Light Blue - Accent -->
    <Color x:Key="WarmColor">#4445B1</Color>
    <!-- (using same as secondary) -->
    <Color x:Key="MutedBlue">#ABCDD7</Color>
    <!-- Light blue for muted -->

    <!-- ===== UI COLORS (Dark Theme) ===== -->
    <Color x:Key="Primary">#4183E1</Color>
    <!-- Azure Blue -->
    <Color x:Key="PrimaryDark">#082A83</Color>
    <!-- True Cobalt -->
    <Color x:Key="Secondary">#4445B1</Color>
    <!-- Ocean Twilight -->
    <Color x:Key="Surface">#0a1a2e</Color>
    <!-- Very dark blue (base) -->
    <Color x:Key="Background">#000000</Color>
    <!-- True black -->
    <Color x:Key="OnBackground">#E8F0F8</Color>
    <!-- Almost white with blue tint -->
    <Color x:Key="OnSurface">#C5D9E8</Color>
    <!-- Light blue-grey -->
    <Color x:Key="MutedText">#8FAECB</Color>
    <!-- Muted light blue -->
    <Color x:Key="BorderColor">#2A4B7A</Color>
    <!-- Medium blue -->

    <!-- ===== STATUS COLORS (unchanged) ===== -->
    <Color x:Key="SuccessColor">#27AE60</Color>
    <Color x:Key="DangerColor">#E74C3C</Color>
    <Color x:Key="WarningColor">#F39C12</Color>
    <!-- Changed to a warm yellow -->
    <Color x:Key="InfoColor">#4183E1</Color>
    <!-- Using primary blue -->

    <!-- ===== GRAY SCALE (adjusted to blue tint) ===== -->
    <Color x:Key="Gray100">#E8F0F8</Color>
    <Color x:Key="Gray200">#C5D9E8</Color>
    <Color x:Key="Gray300">#8FAECB</Color>
    <Color x:Key="Gray400">#5A7D9E</Color>
    <Color x:Key="Gray500">#2A4B7A</Color>
    <Color x:Key="Gray600">#0F2440</Color>
    <Color x:Key="Gray900">#050F1E</Color>
    <Color x:Key="Gray950">#02070E</Color>

    <!-- ===== COMMON COLORS ===== -->
    <Color x:Key="White">#FFFFFF</Color>
    <Color x:Key="Black">#000000</Color>
    <Color x:Key="Magenta">#D600AA</Color>
    <Color x:Key="MidnightBlue">#190649</Color>
    <Color x:Key="OffBlack">#0a0a0a</Color>

    <!-- ===== MAUI DEFAULT KEYS (needed by Styles.xaml) ===== -->
    <Color x:Key="PrimaryDarkText">#E8F0F8</Color>
    <Color x:Key="SecondaryDarkText">#C5D9E8</Color>
    <Color x:Key="PrimaryLightColor">#4183E1</Color>
    <Color x:Key="BackgroundColor">#000000</Color>
    <Color x:Key="CardBackgroundColor">#0F2440</Color>
    <Color x:Key="TextPrimaryColor">#E8F0F8</Color>
    <Color x:Key="TextSecondaryColor">#C5D9E8</Color>
    <Color x:Key="Tertiary">#4445B1</Color>

    <!-- ===== BRUSHES ===== -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource Surface}"/>
    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource Background}"/>
    <SolidColorBrush x:Key="PrimaryColorBrush" Color="{StaticResource PrimaryColor}"/>
    <SolidColorBrush x:Key="SuccessColorBrush" Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="DangerColorBrush" Color="{StaticResource DangerColor}"/>
    <SolidColorBrush x:Key="WarningColorBrush" Color="{StaticResource WarningColor}"/>

</ResourceDictionary>