<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- ===== NEW PALETTE (High Contrast) ===== -->
    <Color x:Key="Primary">#007acc</Color>
    <Color x:Key="Secondary">#3e3e42</Color>
    <Color x:Key="Surface">#252526</Color>
    <Color x:Key="Background">#1e1e1e</Color>
    <Color x:Key="OnBackground">#FFFFFF</Color>
    <Color x:Key="OnSurface">#E0E0E0</Color>
    <Color x:Key="MutedText">#ACACAC</Color>
    <!-- Was #3e3e42 – now bright enough to read -->
    <Color x:Key="BorderColor">#3e3e42</Color>

    <!-- ===== OLD BFP COLORS (mapped) ===== -->
    <Color x:Key="PrimaryColor">#007acc</Color>
    <Color x:Key="PrimaryLightColor">#2980B9</Color>
    <Color x:Key="SecondaryColor">#E67E22</Color>
    <Color x:Key="SuccessColor">#27AE60</Color>
    <Color x:Key="DangerColor">#E74C3C</Color>
    <Color x:Key="WarningColor">#F39C12</Color>
    <Color x:Key="BackgroundColor">#1e1e1e</Color>
    <Color x:Key="CardBackgroundColor">#2d2d30</Color>
    <!-- Slightly lighter than Surface -->
    <Color x:Key="TextPrimaryColor">#FFFFFF</Color>
    <Color x:Key="TextSecondaryColor">#ACACAC</Color>

    <!-- ===== MAUI Defaults ===== -->
    <Color x:Key="PrimaryDark">#ac99ea</Color>
    <Color x:Key="PrimaryDarkText">#242424</Color>
    <Color x:Key="SecondaryDarkText">#9880e5</Color>
    <Color x:Key="Tertiary">#2B0B98</Color>
    <Color x:Key="White">White</Color>
    <Color x:Key="Black">Black</Color>
    <Color x:Key="Magenta">#D600AA</Color>
    <Color x:Key="MidnightBlue">#190649</Color>
    <Color x:Key="OffBlack">#1f1f1f</Color>

    <Color x:Key="Gray100">#E1E1E1</Color>
    <Color x:Key="Gray200">#C8C8C8</Color>
    <Color x:Key="Gray300">#ACACAC</Color>
    <Color x:Key="Gray400">#919191</Color>
    <Color x:Key="Gray500">#6E6E6E</Color>
    <Color x:Key="Gray600">#404040</Color>
    <Color x:Key="Gray900">#212121</Color>
    <Color x:Key="Gray950">#141414</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource Surface}"/>
    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource Background}"/>
    <SolidColorBrush x:Key="PrimaryColorBrush" Color="{StaticResource PrimaryColor}"/>
    <SolidColorBrush x:Key="SuccessColorBrush" Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="DangerColorBrush" Color="{StaticResource DangerColor}"/>
    <SolidColorBrush x:Key="WarningColorBrush" Color="{StaticResource WarningColor}"/>
</ResourceDictionary>