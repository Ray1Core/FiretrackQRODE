<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Firetrack.Views.CategoryItemsPage"
             Title="{Binding CategoryName}"
             BackgroundColor="{StaticResource Background}"
             Shell.TabBarIsVisible="False">

    <Grid RowDefinitions="Auto, *">
        <VerticalStackLayout Grid.Row="0" Padding="20" Spacing="10" BackgroundColor="{StaticResource Background}">
            <Label Text="{Binding CategoryName, StringFormat='📦 {0}'}"
                   FontSize="24"
                   FontAttributes="Bold"
                   TextColor="{StaticResource OnBackground}"
                   HorizontalOptions="Center" />
            <Label Text="{Binding Items.Count, StringFormat='{0} items found'}"
                   FontSize="14"
                   TextColor="{StaticResource Gray300}"
                   HorizontalOptions="Center" />
        </VerticalStackLayout>

        <RefreshView Grid.Row="1" IsRefreshing="{Binding IsBusy}" Command="{Binding LoadItemsCommand}">
            <CollectionView ItemsSource="{Binding Items}"
                            EmptyView="No items found."
                            x:Name="ItemsCollection">
                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical"
                                      Span="2"
                                      VerticalItemSpacing="10"
                                      HorizontalItemSpacing="10" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardStyle}"
                                Padding="10"
                                HeightRequest="180">
                            <Grid RowDefinitions="Auto, Auto, *, Auto, Auto">
                                <Image Grid.Row="0"
                                       Source="qrdefaultest.png"
                                       WidthRequest="50"
                                       HeightRequest="50"
                                       HorizontalOptions="Center"
                                       Aspect="AspectFit" />
                                <Label Grid.Row="1"
                                       Text="{Binding QRCode}"
                                       FontSize="10"
                                       TextColor="{StaticResource Gray300}"
                                       HorizontalOptions="Center" />
                                <Label Grid.Row="2"
                                       Text="{Binding Name}"
                                       FontSize="14"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource OnBackground}"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"
                                       LineBreakMode="TailTruncation"
                                       MaxLines="1" />
                                <Label Grid.Row="3"
                                       Text="{Binding Status}"
                                       FontSize="12"
                                       Padding="6,2"
                                       HorizontalTextAlignment="Center"
                                       TextColor="White"
                                       BackgroundColor="{Binding Status, Converter={StaticResource StatusToColorConverter}}"
                                       HorizontalOptions="Center" />
                                <Label Grid.Row="4"
                                       Text="{Binding AssignedToUsername, StringFormat='{0}'}"
                                       FontSize="10"
                                       TextColor="{StaticResource Gray300}"
                                       HorizontalOptions="Center" />
                            </Grid>

                            <!-- Tap gesture -->
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.ItemTappedCommand}"
                                                      CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>