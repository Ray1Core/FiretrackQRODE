<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Firetrack.Views.ForgotPasswordPage"
             Title="Reset Password"
             BackgroundColor="{StaticResource Background}">

    <Grid Padding="30" VerticalOptions="Center">
        <VerticalStackLayout Spacing="24">
            <Label Text="🔑 Reset Password"
                   FontSize="28"
                   FontAttributes="Bold"
                   TextColor="{StaticResource OnBackground}"
                   HorizontalOptions="Center" />

            <Label Text="Enter your username to receive an OTP."
                   FontSize="14"
                   TextColor="{StaticResource Gray300}"
                   HorizontalOptions="Center" />

            <Entry Placeholder="Username"
                   Text="{Binding Username}"
                   TextColor="{StaticResource OnBackground}"
                   PlaceholderColor="{StaticResource Gray300}"
                   BackgroundColor="{StaticResource Surface}" />

            <Button Text="Send OTP"
                    Command="{Binding SendOtpCommand}"
                    Style="{StaticResource PrimaryButton}" />

            <Entry Placeholder="Enter OTP (6 digits)"
                   Text="{Binding OtpCode}"
                   TextColor="{StaticResource OnBackground}"
                   PlaceholderColor="{StaticResource Gray300}"
                   BackgroundColor="{StaticResource Surface}"
                   Keyboard="Numeric"
                   MaxLength="6" />

            <Button Text="Verify OTP &amp; Reset Password"
                    Command="{Binding ResetPasswordCommand}"
                    Style="{StaticResource SuccessButton}" />

            <Entry Placeholder="New Password"
                   Text="{Binding NewPassword}"
                   IsPassword="True"
                   TextColor="{StaticResource OnBackground}"
                   PlaceholderColor="{StaticResource Gray300}"
                   BackgroundColor="{StaticResource Surface}" />

            <!-- This button is correct: it goes back to Login, not Dashboard -->
            <Button Text="← Back to Login"
                    Command="{Binding GoBackCommand}"
                    Style="{StaticResource SecondaryButton}" />

            <Label Text="{Binding StatusMessage}"
                   TextColor="{Binding StatusMessage, Converter={StaticResource StringToColorConverter}}"
                   HorizontalOptions="Center"
                   FontSize="14" />

            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               Color="{StaticResource OnBackground}" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>