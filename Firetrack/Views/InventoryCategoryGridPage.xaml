<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Firetrack.Views.InventoryCategoryGridPage"
             Title="{Binding Mode, StringFormat='{0} Equipment'}"
             BackgroundColor="{StaticResource Background}"
             Shell.TabBarIsVisible="False">

    <Grid RowDefinitions="Auto, *">
        <!-- Header -->
        <VerticalStackLayout Grid.Row="0" Padding="20" Spacing="10" BackgroundColor="{StaticResource Background}">
            <Grid ColumnDefinitions="*, Auto">
                <Label Text="{Binding Mode, StringFormat='📋 {0} Equipment'}"
                       FontSize="24"
                       FontAttributes="Bold"
                       TextColor="{StaticResource OnBackground}"
                       VerticalOptions="Center" />
                <!-- Add button visible only in inventory mode -->
                <Button Grid.Column="1"
                        Text="➕ Add"
                        Command="{Binding GoToAddEquipmentCommand}"
                        Style="{StaticResource PrimaryButton}"
                        HeightRequest="40"
                        FontSize="14"
                        IsVisible="{Binding Mode, Converter={StaticResource IsInventoryModeConverter}}" />
            </Grid>
            <Label Text="Tap a category to view all items."
                   FontSize="14"
                   TextColor="{StaticResource Gray300}" />
        </VerticalStackLayout>

        <!-- Category Grid -->
        <RefreshView Grid.Row="1" IsRefreshing="{Binding IsBusy}" Command="{Binding LoadCategoriesCommand}">
            <CollectionView ItemsSource="{Binding Categories}"
                            EmptyView="No equipment found."
                            x:Name="CategoryCollection">
                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical"
                                      Span="2"
                                      VerticalItemSpacing="10"
                                      HorizontalItemSpacing="10" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardStyle}"
                                Padding="10"
                                HeightRequest="140">
                            <Grid RowDefinitions="Auto, *, Auto">
                                <Label Grid.Row="0"
                                       Text="{Binding Type, Converter={StaticResource StringToEmojiConverter}}"
                                       FontSize="24"
                                       HorizontalOptions="Center" />
                                <Label Grid.Row="1"
                                       Text="{Binding Name}"
                                       FontSize="14"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource OnBackground}"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"
                                       LineBreakMode="WordWrap"
                                       MaxLines="2" />
                                <Border Grid.Row="2"
                                        BackgroundColor="{StaticResource PrimaryColor}"
                                        StrokeThickness="0"
                                        Padding="8,4"
                                        StrokeShape="RoundRectangle 12"
                                        HorizontalOptions="Center">
                                    <Label Text="{Binding Count, StringFormat='×{0}'}"
                                           FontSize="12"
                                           TextColor="White" />
                                </Border>
                            </Grid>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.CategoryTappedCommand}"
                                                      CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>