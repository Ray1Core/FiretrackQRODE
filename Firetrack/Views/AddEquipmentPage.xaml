<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Firetrack.Views.AddEquipmentPage"
             Title="Add Equipment"
             BackgroundColor="{StaticResource Background}"
             Shell.TabBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <!-- Header -->
            <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                <Label Text="➕ Add New Equipment"
                       FontSize="28"
                       FontAttributes="Bold"
                       TextColor="{StaticResource OnBackground}"
                       HorizontalOptions="Center" />
                <Label Text="Enter name and, type then save — a unique QR code is generated automatically."
                       FontSize="14"
                       TextColor="{StaticResource Gray300}"
                       HorizontalOptions="Center" />
            </VerticalStackLayout>

            <!-- QR PREVIEW (appears after save) -->
            <Border IsVisible="{Binding HasQrPreview}"
                    Style="{StaticResource CardStyle}"
                    Padding="15">
                <VerticalStackLayout Spacing="10">
                    <Label Text="✅ QR Code Generated"
                           FontAttributes="Bold"
                           FontSize="16"
                           TextColor="{StaticResource SuccessColor}"
                           HorizontalOptions="Center" />
                    <Label Text="Print this and stick it on the physical equipment."
                           FontSize="13"
                           TextColor="{StaticResource Gray300}"
                           HorizontalOptions="Center" />
                    <Border BackgroundColor="White"
                            Padding="10"
                            StrokeThickness="0"
                            HorizontalOptions="Center"
                            StrokeShape="RoundRectangle 8">
                        <Image Source="{Binding QrImage}"
                               WidthRequest="200"
                               HeightRequest="200"
                               Aspect="AspectFit" />
                    </Border>
                    <Label Text="{Binding SavedQrValue}"
                           FontSize="12"
                           FontAttributes="Bold"
                           TextColor="{StaticResource OnBackground}"
                           HorizontalOptions="Center"
                           LineBreakMode="WordWrap" />
                </VerticalStackLayout>
            </Border>

            <!-- Form Card -->
            <Border Style="{StaticResource CardStyle}">
                <VerticalStackLayout Spacing="16">

                    <Entry Style="{StaticResource EntryStyle}"
                           Placeholder="Equipment Name"
                           Text="{Binding Name}"
                           TextColor="{StaticResource OnBackground}"
                           PlaceholderColor="{StaticResource Gray300}"
                           BackgroundColor="{StaticResource Surface}" />

                    <Picker Title="Select Type"
                            ItemsSource="{Binding Types}"
                            SelectedItem="{Binding Type}"
                            TextColor="{StaticResource OnBackground}"
                            TitleColor="{StaticResource Gray300}"
                            BackgroundColor="{StaticResource Surface}" />

                    <Picker Title="Select Status"
                            ItemsSource="{Binding Statuses}"
                            SelectedItem="{Binding Status}"
                            TextColor="{StaticResource OnBackground}"
                            TitleColor="{StaticResource Gray300}"
                            BackgroundColor="{StaticResource Surface}" />

                    <Button Text="Save Equipment"
                            Style="{StaticResource SuccessButton}"
                            Command="{Binding SaveCommand}" />

                    <ActivityIndicator IsRunning="{Binding IsBusy}"
                                       Color="{StaticResource OnBackground}" />

                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>