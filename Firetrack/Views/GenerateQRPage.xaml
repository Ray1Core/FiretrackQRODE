<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Firetrack.Views.GenerateQRPage"
             Title="Generate QR Sticker"
             Shell.TabBarIsVisible="False"
             BackgroundColor="{StaticResource Background}">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">

            <Label Text="📱 QR Code Generator"
                   FontSize="28"
                   FontAttributes="Bold"
                   TextColor="{StaticResource PrimaryColor}"
                   HorizontalOptions="Center" />

            <Label Text="Enter any text to generate a QR code sticker."
                   FontSize="14"
                   TextColor="{StaticResource Gray300}"
                   HorizontalOptions="Center" />

            <!-- Input -->
            <Border Style="{StaticResource CardStyle}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Text / QR Code Value"
                           FontAttributes="Bold"
                           FontSize="16"
                           TextColor="{StaticResource PrimaryColor}" />
                    <Entry Placeholder="e.g., HOSE001, TOOL002, or any text"
                           Text="{Binding InputText}"
                           TextColor="{StaticResource OnBackground}"
                           PlaceholderColor="{StaticResource Gray300}"
                           BackgroundColor="{StaticResource Surface}" />
                    <Button Text="Generate QR Code"
                            Command="{Binding GenerateCommand}"
                            Style="{StaticResource PrimaryButton}" />
                </VerticalStackLayout>
            </Border>

            <!-- Generated QR Image -->
            <Border Style="{StaticResource CardStyle}" IsVisible="{Binding IsImageVisible}">
                <VerticalStackLayout Spacing="12" HorizontalOptions="Center">
                    <Label Text="Generated QR Code"
                           FontAttributes="Bold"
                           FontSize="16"
                           TextColor="{StaticResource PrimaryColor}"
                           HorizontalOptions="Center" />
                    <Image Source="{Binding QrImageSource}"
                           WidthRequest="200"
                           HeightRequest="200"
                           HorizontalOptions="Center" />
                    <Grid ColumnDefinitions="*, *" ColumnSpacing="10">
                        <Button Text="💾 Save"
                                Command="{Binding SaveCommand}"
                                Style="{StaticResource SuccessButton}"
                                HeightRequest="40" />
                        <Button Grid.Column="1"
                                Text="📤 Share"
                                Command="{Binding ShareCommand}"
                                Style="{StaticResource PrimaryButton}"
                                HeightRequest="40" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Status Message -->
            <Label Text="{Binding StatusMessage}"
                   TextColor="{Binding StatusMessage, Converter={StaticResource StringToColorConverter}}"
                   FontSize="14"
                   HorizontalOptions="Center" />

            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               Color="{StaticResource PrimaryColor}"
                               HorizontalOptions="Center" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>