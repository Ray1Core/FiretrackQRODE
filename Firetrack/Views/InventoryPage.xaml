<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Firetrack.Views.InventoryPage"
             Title="Equipment Inventory"
             BackgroundColor="{StaticResource Background}"
             Shell.TabBarIsVisible="False">

    <Grid RowDefinitions="Auto, Auto, *">

        <!-- Header with Add Button -->
        <VerticalStackLayout Grid.Row="0" Padding="20" Spacing="10" BackgroundColor="{StaticResource Background}">
            <Grid ColumnDefinitions="*, Auto">
                <Label Text="📋 Equipment Inventory"
                       FontSize="24"
                       FontAttributes="Bold"
                       TextColor="{StaticResource OnBackground}"
                       VerticalOptions="Center" />
                <Button Grid.Column="1"
                        Text="➕ Add"
                        Command="{Binding GoToAddEquipmentCommand}"
                        Style="{StaticResource PrimaryButton}"
                        HeightRequest="40"
                        FontSize="14" />
            </Grid>
            <Label Text="Tap an item to view details and actions."
                   FontSize="14"
                   TextColor="{StaticResource Gray300}" />
        </VerticalStackLayout>

        <!-- Search Bar -->
        <VerticalStackLayout Grid.Row="1" Padding="20" Spacing="10" BackgroundColor="{StaticResource Background}">
            <Grid ColumnDefinitions="*, Auto" ColumnSpacing="10">
                <Entry Style="{StaticResource EntryStyle}"
                       Placeholder="Search by name, QR, or type..."
                       Text="{Binding SearchText}"
                       TextColor="{StaticResource OnBackground}"
                       PlaceholderColor="{StaticResource Gray300}"
                       BackgroundColor="{StaticResource Surface}" />
                <Button Grid.Column="1"
                        Text="🔍 Search"
                        Style="{StaticResource PrimaryButton}"
                        Command="{Binding SearchCommand}"
                        WidthRequest="100" />
            </Grid>
        </VerticalStackLayout>

        <!-- Equipment List (clean, tap to open detail) -->
        <RefreshView Grid.Row="2" IsRefreshing="{Binding IsBusy}" Command="{Binding LoadEquipmentsCommand}">
            <CollectionView ItemsSource="{Binding Equipments}"
                            SelectionMode="None"
                            EmptyView="No equipment found.">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardStyle}" Margin="10,5" Padding="10">
                            <Grid ColumnDefinitions="*, Auto" RowDefinitions="Auto, Auto, Auto, Auto">

                                <!-- Row 0: Name + QR Code -->
                                <Label Grid.Row="0" Grid.Column="0"
                                       Text="{Binding Name}"
                                       FontSize="16"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource OnBackground}"
                                       VerticalOptions="Center" />
                                <Label Grid.Row="0" Grid.Column="1"
                                       Text="{Binding QRCode}"
                                       FontSize="12"
                                       TextColor="{StaticResource Gray300}"
                                       VerticalOptions="Center" />

                                <!-- Row 1: Type -->
                                <Label Grid.Row="1" Grid.Column="0"
                                       Text="{Binding Type, StringFormat='Type: {0}'}"
                                       FontSize="13"
                                       TextColor="{StaticResource Gray300}" />

                                <!-- Row 2: Status (now wrapped and left-aligned) -->
                                <Label Grid.Row="2" Grid.Column="0"
                                       Text="{Binding Status}"
                                       FontSize="13"
                                       TextColor="White"
                                       Padding="6,2"
                                       Margin="0,4,0,0"
                                       HorizontalOptions="Start"
                                       HorizontalTextAlignment="Start"
                                       BackgroundColor="{Binding Status, Converter={StaticResource StatusToColorConverter}}" />

                                <!-- Row 3: Assigned To -->
                                <Label Grid.Row="3" Grid.Column="0"
                                       Text="{Binding AssignedToUsername, StringFormat='Assigned to: {0}'}"
                                       FontSize="12"
                                       TextColor="{StaticResource Gray300}" />

                                <!-- Tap gesture to navigate to detail page -->
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.ItemTappedCommand}"
                                                          CommandParameter="{Binding .}" />
                                </Grid.GestureRecognizers>

                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

    </Grid>
</ContentPage>