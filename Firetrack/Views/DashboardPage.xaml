<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Firetrack.Views.DashboardPage"
             Title="Dashboard"
             Shell.TabBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">

            <!-- ========== HEADER ========== -->
            <Grid ColumnDefinitions="Auto, *, Auto, Auto" RowDefinitions="Auto" ColumnSpacing="10" VerticalOptions="Start">
                <Button Grid.Column="0"
                        Text="☰"
                        BackgroundColor="Transparent"
                        TextColor="{StaticResource OnBackground}"
                        WidthRequest="50"
                        HeightRequest="50"
                        FontSize="28"
                        CornerRadius="0"
                        HorizontalOptions="Center"
                        VerticalOptions="Center"
                        Command="{Binding ToggleFlyoutCommand}" />

                <Grid Grid.Column="1"
                      ColumnDefinitions="Auto, *"
                      RowDefinitions="Auto, Auto"
                      ColumnSpacing="10"
                      HorizontalOptions="Center"
                      VerticalOptions="Center">
                    <Border Grid.Row="0" Grid.RowSpan="2"
                            Grid.Column="0"
                            Stroke="Transparent"
                            StrokeThickness="0"
                            WidthRequest="60"
                            HeightRequest="60"
                            StrokeShape="RoundRectangle 60"
                            BackgroundColor="{StaticResource Surface}"
                            HorizontalOptions="Center"
                            VerticalOptions="Center">
                        <Image Source="profile.jpg"
                               Aspect="AspectFill"
                               WidthRequest="60"
                               HeightRequest="60"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                    </Border>
                    <Label Grid.Row="0"
                           Grid.Column="1"
                           Text="{Binding FullName}"
                           FontSize="20"
                           FontAttributes="Bold"
                           TextColor="{StaticResource OnBackground}"
                           VerticalOptions="End"
                           HorizontalOptions="Start" />
                    <Label Grid.Row="1"
                           Grid.Column="1"
                           Text="{Binding UserRole, StringFormat='Role: {0}'}"
                           FontSize="14"
                           TextColor="{StaticResource TextSecondaryColor}"
                           VerticalOptions="Start"
                           HorizontalOptions="Start" />
                </Grid>

                <Button Grid.Column="2"
                        Text="🔔"
                        BackgroundColor="Transparent"
                        TextColor="{StaticResource OnBackground}"
                        Command="{Binding GoToNotificationsCommand}"
                        WidthRequest="50"
                        HeightRequest="50"
                        FontSize="24"
                        CornerRadius="0"
                        HorizontalOptions="Center"
                        VerticalOptions="Center" />
                <Button Grid.Column="3"
                        Text="🚪"
                        BackgroundColor="Transparent"
                        TextColor="{StaticResource DangerColor}"
                        Command="{Binding LogoutCommand}"
                        WidthRequest="50"
                        HeightRequest="50"
                        FontSize="24"
                        CornerRadius="0"
                        HorizontalOptions="Center"
                        VerticalOptions="Center" />
            </Grid>

            <!-- ========== METRICS CARDS (4 rows × 2 columns) ========== -->
            <Grid ColumnDefinitions="*, *" RowDefinitions="Auto, Auto, Auto, Auto" ColumnSpacing="12" RowSpacing="12">

                <!-- Row 0 -->
                <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource CardStyle}" Padding="10">
                    <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                        <Label Text="📦 Total" FontSize="14" TextColor="{StaticResource Gray300}" />
                        <Label Text="{Binding TotalEquipment}" FontSize="24" FontAttributes="Bold" TextColor="{StaticResource PrimaryColor}" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource CardStyle}" Padding="10">
                    <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                        <Label Text="✅ Available" FontSize="14" TextColor="{StaticResource Gray300}" />
                        <Label Text="{Binding AvailableCount}" FontSize="24" FontAttributes="Bold" TextColor="{StaticResource SuccessColor}" />
                    </VerticalStackLayout>
                </Border>

                <!-- Row 1 -->
                <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource CardStyle}" Padding="10">
                    <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                        <Label Text="🔄 Issued" FontSize="14" TextColor="{StaticResource Gray300}" />
                        <Label Text="{Binding IssuedCount}" FontSize="24" FontAttributes="Bold" TextColor="{StaticResource PrimaryColor}" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource CardStyle}" Padding="10">
                    <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                        <Label Text="⚠️ Damaged" FontSize="14" TextColor="{StaticResource Gray300}" />
                        <Label Text="{Binding DamagedCount}" FontSize="24" FontAttributes="Bold" TextColor="{StaticResource DangerColor}" />
                    </VerticalStackLayout>
                </Border>

                <!-- Row 2 -->
                <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource CardStyle}" Padding="10">
                    <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                        <Label Text="🔧 In Repair" FontSize="14" TextColor="{StaticResource Gray300}" />
                        <Label Text="{Binding InRepairCount}" FontSize="24" FontAttributes="Bold" TextColor="{StaticResource SecondaryColor}" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource CardStyle}" Padding="10">
                    <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                        <Label Text="📋 Pending Requests" FontSize="14" TextColor="{StaticResource Gray300}" />
                        <Label Text="{Binding PendingRequests}" FontSize="24" FontAttributes="Bold" TextColor="{StaticResource WarningColor}" />
                    </VerticalStackLayout>
                </Border>

                <!-- Row 3 (NEW) -->
                <Border Grid.Row="3" Grid.Column="0" Style="{StaticResource CardStyle}" Padding="10">
                    <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                        <Label Text="🚫 Cancelled" FontSize="14" TextColor="{StaticResource Gray300}" />
                        <Label Text="{Binding RejectedRequests}" FontSize="24" FontAttributes="Bold" TextColor="{StaticResource DangerColor}" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Row="3" Grid.Column="1" Style="{StaticResource CardStyle}" Padding="10">
                    <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                        <Label Text="🗑️ Disposed" FontSize="14" TextColor="{StaticResource Gray300}" />
                        <Label Text="{Binding DisposedCount}" FontSize="24" FontAttributes="Bold" TextColor="{StaticResource Gray500}" />
                    </VerticalStackLayout>
                </Border>

            </Grid>

            <!-- ========== CHART ========== -->
            <Border Style="{StaticResource CardStyle}" Padding="10">
                <VerticalStackLayout>
                    <Label Text="📈 Issued Trend (Last 7 Days)" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource PrimaryColor}" Margin="0,0,0,10" />
                    <GraphicsView Drawable="{Binding ChartDrawable}"
                                  HeightRequest="200"
                                  BackgroundColor="Transparent" />
                </VerticalStackLayout>
            </Border>

            <!-- ========== ASSIGNED EQUIPMENT (Personnel only) ========== -->
            <Border Style="{StaticResource CardStyle}" Padding="0"
                    IsVisible="{Binding IsAdmin, Converter={StaticResource InvertedBoolConverter}}">
                <VerticalStackLayout>
                    <Label Text="📦 Your Assigned Equipment"
                           FontAttributes="Bold"
                           FontSize="16"
                           TextColor="{StaticResource PrimaryColor}"
                           Margin="15,10,15,5" />
                    <CollectionView ItemsSource="{Binding MyEquipment}" HeightRequest="200">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="*, Auto, Auto, Auto" Padding="10,6">
                                    <Label Text="{Binding Name}"
                                           Grid.Column="0"
                                           FontSize="14"
                                           TextColor="{StaticResource TextPrimaryColor}" />
                                    <Label Grid.Column="1"
                                           Text="{Binding Status}"
                                           FontSize="12"
                                           Padding="6,2"
                                           Margin="5,0"
                                           HorizontalTextAlignment="Center"
                                           TextColor="White"
                                           BackgroundColor="{Binding Status, Converter={StaticResource StatusToColorConverter}}">
                                        <Label.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.ShowEquipmentDetailsCommand}"
                                                                  CommandParameter="{Binding .}" />
                                        </Label.GestureRecognizers>
                                    </Label>
                                    <Button Grid.Column="2"
                                            Text="↩️ Return"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.ReturnEquipmentCommand}"
                                            CommandParameter="{Binding .}"
                                            BackgroundColor="{StaticResource WarningColor}"
                                            TextColor="White"
                                            FontSize="11"
                                            CornerRadius="6"
                                            Padding="8,4"
                                            HeightRequest="30" />
                                    <Button Grid.Column="3"
                                            Text="⚠️ Report"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.ReportDamageCommand}"
                                            CommandParameter="{Binding .}"
                                            BackgroundColor="{StaticResource DangerColor}"
                                            TextColor="White"
                                            FontSize="11"
                                            CornerRadius="6"
                                            Padding="8,4"
                                            HeightRequest="30"
                                            IsVisible="{Binding Status, Converter={StaticResource IsNotDamagedConverter}}" />
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Border>

            <!-- ========== QUICK ACTIONS ========== -->
            <Grid ColumnDefinitions="*, *" RowDefinitions="Auto, Auto" ColumnSpacing="12" RowSpacing="12">
                <Button Grid.Row="0" Grid.Column="0"
                        Text="🔄 Transfer"
                        Command="{Binding GoToTransferCommand}"
                        Style="{StaticResource PrimaryButton}"
                        IsVisible="{Binding IsAdmin}" />
                <Button Grid.Row="0" Grid.Column="1"
                        Text="📷 Scan QR"
                        Command="{Binding GoToScannerCommand}"
                        Style="{StaticResource PrimaryButton}" />

                <Button Grid.Row="0" Grid.Column="0"
                        Text="📋 Request"
                        Command="{Binding GoToRequestEquipmentCommand}"
                        Style="{StaticResource PrimaryButton}"
                        IsVisible="{Binding IsAdmin, Converter={StaticResource InvertedBoolConverter}}" />

                <Button Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                        Text="📋 Clearance"
                        Command="{Binding GoToClearanceCommand}"
                        Style="{StaticResource PrimaryButton}"
                        IsVisible="{Binding IsAdmin}" />
                <Button Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                        Text="👤 Profile"
                        Command="{Binding GoToProfileCommand}"
                        Style="{StaticResource PrimaryButton}"
                        IsVisible="{Binding IsAdmin, Converter={StaticResource InvertedBoolConverter}}" />
            </Grid>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>