<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Firetrack.Views.EquipmentCategoryPage"
             Title="Equipment Inventory"
             BackgroundColor="{StaticResource Background}"
             Shell.TabBarIsVisible="False">

    <Grid RowDefinitions="Auto, Auto, Auto, *">

        <!-- Header with Add Button -->
        <VerticalStackLayout Grid.Row="0" Padding="20,10" Spacing="5" BackgroundColor="{StaticResource Background}">
            <Grid ColumnDefinitions="*, Auto">
                <Label Text="📋 Equipment Inventory"
                       FontSize="24"
                       FontAttributes="Bold"
                       TextColor="{StaticResource OnBackground}"
                       VerticalOptions="Center" />
                <Button Grid.Column="1"
                        Text="➕ Add"
                        Command="{Binding GoToAddEquipmentCommand}"
                        Style="{StaticResource PrimaryButton}"
                        HeightRequest="40"
                        FontSize="14"
                        IsVisible="{Binding IsAdmin}" />
            </Grid>
        </VerticalStackLayout>

        <!-- Filter & Search -->
        <VerticalStackLayout Grid.Row="1" Padding="20,0,20,10" Spacing="8">
            <Grid ColumnDefinitions="*, Auto" ColumnSpacing="10">
                <Picker Title="Filter by Status"
                        ItemsSource="{Binding StatusFilterOptions}"
                        SelectedItem="{Binding SelectedStatusFilter}"
                        TextColor="{StaticResource OnBackground}"
                        TitleColor="{StaticResource Gray300}"
                        BackgroundColor="{StaticResource Surface}" />
                <Entry Grid.Column="1"
                       Style="{StaticResource EntryStyle}"
                       Placeholder="Search..."
                       Text="{Binding SearchText}"
                       TextColor="{StaticResource OnBackground}"
                       PlaceholderColor="{StaticResource Gray300}"
                       BackgroundColor="{StaticResource Surface}"
                       WidthRequest="120" />
            </Grid>
            <Button Text="🔍 Apply Filter"
                    Command="{Binding ApplyFilterCommand}"
                    Style="{StaticResource PrimaryButton}"
                    HeightRequest="35"
                    FontSize="12" />
        </VerticalStackLayout>

        <!-- Category Grid -->
        <RefreshView Grid.Row="2" IsRefreshing="{Binding IsBusy}" Command="{Binding LoadCategoriesCommand}">
            <CollectionView ItemsSource="{Binding Categories}"
                            EmptyView="No equipment found."
                            x:Name="CategoryCollection">
                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical"
                                      Span="2"
                                      VerticalItemSpacing="10"
                                      HorizontalItemSpacing="10" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardStyle}"
                                Padding="10"
                                HeightRequest="140">
                            <Grid RowDefinitions="Auto, *, Auto">
                                <Label Grid.Row="0"
                                       Text="{Binding Type, Converter={StaticResource StringToEmojiConverter}}"
                                       FontSize="24"
                                       HorizontalOptions="Center" />
                                <Label Grid.Row="1"
                                       Text="{Binding Name}"
                                       FontSize="14"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource OnBackground}"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"
                                       LineBreakMode="WordWrap"
                                       MaxLines="2" />
                                <Border Grid.Row="2"
                                        BackgroundColor="{StaticResource PrimaryColor}"
                                        StrokeThickness="0"
                                        Padding="8,4"
                                        StrokeShape="RoundRectangle 12"
                                        HorizontalOptions="Center">
                                    <Label Text="{Binding Count, StringFormat='×{0}'}"
                                           FontSize="12"
                                           TextColor="White" />
                                </Border>
                            </Grid>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.CategoryTappedCommand}"
                                                      CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

        <ActivityIndicator Grid.Row="3" IsRunning="{Binding IsBusy}" Color="{StaticResource PrimaryColor}" />
    </Grid>
</ContentPage>