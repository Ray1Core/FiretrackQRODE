<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Firetrack.Views.EquipmentCategoryPage"
             Title="Equipment Inventory"
             BackgroundColor="{StaticResource Background}"
             Shell.TabBarIsVisible="False">

    <Grid RowDefinitions="Auto, Auto, Auto, *">

        <!-- Header with Add Button -->
        <VerticalStackLayout Grid.Row="0" Padding="20,10" Spacing="5" BackgroundColor="{StaticResource Background}">
            <Grid ColumnDefinitions="*, Auto">
                <Label Text="📋 Equipment Inventory"
                       FontSize="24"
                       FontAttributes="Bold"
                       TextColor="{StaticResource OnBackground}"
                       VerticalOptions="Center" />
                <!-- Add button already visible only for Admin -->
                <Button Grid.Column="1"
                        Text="➕ Add"
                        Command="{Binding GoToAddEquipmentCommand}"
                        Style="{StaticResource PrimaryButton}"
                        HeightRequest="40"
                        FontSize="14"
                        IsVisible="{Binding IsAdmin}" />
            </Grid>
        </VerticalStackLayout>

        <!-- Status Metrics (Available, Stack In, Stack Out) – visible ONLY for Admin -->
        <Grid Grid.Row="1" 
              Padding="15,0,15,10" 
              ColumnDefinitions="*,*,*" 
              ColumnSpacing="6"
              IsVisible="{Binding IsAdmin}">
            <Border Grid.Column="0" BackgroundColor="{StaticResource SuccessColor}" Padding="6,4" StrokeThickness="0" StrokeShape="RoundRectangle 6">
                <VerticalStackLayout Spacing="0" HorizontalOptions="Center">
                    <Label Text="{Binding AvailableCount}" FontSize="16" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center" />
                    <Label Text="Available" FontSize="10" TextColor="White" HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Border>
            <Border Grid.Column="1" BackgroundColor="{StaticResource WarningColor}" Padding="6,4" StrokeThickness="0" StrokeShape="RoundRectangle 6">
                <VerticalStackLayout Spacing="0" HorizontalOptions="Center">
                    <Label Text="{Binding StackInCount}" FontSize="16" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center" />
                    <Label Text="Stack In" FontSize="10" TextColor="White" HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Border>
            <Border Grid.Column="2" BackgroundColor="{StaticResource DangerColor}" Padding="6,4" StrokeThickness="0" StrokeShape="RoundRectangle 6">
                <VerticalStackLayout Spacing="0" HorizontalOptions="Center">
                    <Label Text="{Binding StackOutCount}" FontSize="16" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center" />
                    <Label Text="Stack Out" FontSize="10" TextColor="White" HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Border>
        </Grid>

        <!-- Search Bar -->
        <VerticalStackLayout Grid.Row="2" Padding="20,0,20,10" Spacing="8">
            <Grid ColumnDefinitions="*, Auto" ColumnSpacing="10">
                <Entry Style="{StaticResource EntryStyle}"
                       Placeholder="Search by name, QR, or type..."
                       Text="{Binding SearchText}"
                       TextColor="{StaticResource OnBackground}"
                       PlaceholderColor="{StaticResource Gray300}"
                       BackgroundColor="{StaticResource Surface}" />
                <Button Grid.Column="1"
                        Text="🔍 Search"
                        Style="{StaticResource PrimaryButton}"
                        Command="{Binding SearchCommand}"
                        WidthRequest="100"
                        HeightRequest="40" />
            </Grid>
        </VerticalStackLayout>

        <!-- Category Grid (square boxes) -->
        <RefreshView Grid.Row="3" IsRefreshing="{Binding IsBusy}" Command="{Binding LoadCategoriesCommand}">
            <CollectionView ItemsSource="{Binding Categories}"
                            EmptyView="No equipment found."
                            x:Name="CategoryCollection">
                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical"
                                      Span="2"
                                      VerticalItemSpacing="10"
                                      HorizontalItemSpacing="10" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardStyle}"
                                Padding="10"
                                HeightRequest="140">
                            <Grid RowDefinitions="Auto, *, Auto">
                                <!-- Type icon -->
                                <Label Grid.Row="0"
                                       Text="{Binding Type, Converter={StaticResource StringToEmojiConverter}}"
                                       FontSize="24"
                                       HorizontalOptions="Center" />
                                <!-- Name -->
                                <Label Grid.Row="1"
                                       Text="{Binding Name}"
                                       FontSize="14"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource OnBackground}"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"
                                       LineBreakMode="WordWrap"
                                       MaxLines="2" />
                                <!-- Quantity badge – updated StringFormat -->
                                <Border Grid.Row="2"
                                        BackgroundColor="{StaticResource PrimaryColor}"
                                        StrokeThickness="0"
                                        Padding="8,4"
                                        StrokeShape="RoundRectangle 12"
                                        HorizontalOptions="Center">
                                    <Label Text="{Binding Count, StringFormat='Quantity: {0}'}"
                                           FontSize="12"
                                           TextColor="White" />
                                </Border>
                            </Grid>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.CategoryTappedCommand}"
                                                      CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

        <ActivityIndicator Grid.Row="3" IsRunning="{Binding IsBusy}" Color="{StaticResource PrimaryColor}" VerticalOptions="Center" HorizontalOptions="Center" IsVisible="{Binding IsBusy}" />

    </Grid>
</ContentPage>