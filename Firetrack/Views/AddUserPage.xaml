<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Firetrack.Views.AddUserPage"
             Title="Add User"
             BackgroundColor="{StaticResource Background}">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">
            <!-- Header -->
            <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                <Label Text="👤 Create New Account"
                       FontSize="28"
                       FontAttributes="Bold"
                       TextColor="{StaticResource OnBackground}"
                       HorizontalOptions="Center" />
                <Label Text="Fill in the details to add a new user."
                       FontSize="14"
                       TextColor="{StaticResource Gray300}"
                       HorizontalOptions="Center" />
            </VerticalStackLayout>

            <!-- Form Card -->
            <Border Style="{StaticResource CardStyle}">
                <VerticalStackLayout Spacing="16">
                    <Entry Style="{StaticResource EntryStyle}"
                           Placeholder="Username"
                           Text="{Binding Username}"
                           TextColor="{StaticResource OnBackground}"
                           PlaceholderColor="{StaticResource Gray300}"
                           BackgroundColor="{StaticResource Surface}" />

                    <Entry Style="{StaticResource EntryStyle}"
                           Placeholder="Password"
                           IsPassword="True"
                           Text="{Binding Password}"
                           TextColor="{StaticResource OnBackground}"
                           PlaceholderColor="{StaticResource Gray300}"
                           BackgroundColor="{StaticResource Surface}" />

                    <Entry Style="{StaticResource EntryStyle}"
                           Placeholder="Full Name"
                           Text="{Binding FullName}"
                           TextColor="{StaticResource OnBackground}"
                           PlaceholderColor="{StaticResource Gray300}"
                           BackgroundColor="{StaticResource Surface}" />

                    <Picker Title="Select Role"
                            ItemsSource="{Binding Roles}"
                            SelectedItem="{Binding Role}"
                            TextColor="{StaticResource OnBackground}"
                            TitleColor="{StaticResource Gray300}"
                            BackgroundColor="{StaticResource Surface}" />

                    <!-- Create Button Only (Cancel removed) -->
                    <Button Text="Create Account"
                            Style="{StaticResource SuccessButton}"
                            Command="{Binding SaveUserCommand}" />

                    <ActivityIndicator IsRunning="{Binding IsBusy}"
                                       Color="{StaticResource OnBackground}" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>