<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Firetrack.Views.TransferPage"
             Title="Digital Handshake"
             BackgroundColor="{StaticResource Background}"
             Shell.TabBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">

            <!-- Header -->
            <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                <Label Text="🔄 Digital Handshake"
                       FontSize="28"
                       FontAttributes="Bold"
                       TextColor="{StaticResource PrimaryColor}"
                       HorizontalOptions="Center" />
                <Label Text="4‑step transfer of equipment responsibility."
                       FontSize="14"
                       TextColor="{StaticResource Gray300}"
                       HorizontalOptions="Center" />
            </VerticalStackLayout>

            <!-- Step 1: Scan Equipment -->
            <Border Style="{StaticResource CardStyle}" Padding="10">
                <VerticalStackLayout Spacing="8">
                    <Grid ColumnDefinitions="Auto, *">
                        <Label Text="1" FontSize="20" FontAttributes="Bold" TextColor="{StaticResource PrimaryColor}" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="Scan Equipment QR" FontAttributes="Bold" FontSize="16" TextColor="{StaticResource PrimaryColor}" />
                    </Grid>
                    <Button Text="📷 Scan Equipment QR"
                            Command="{Binding ScanEquipmentCommand}"
                            Style="{StaticResource PrimaryButton}"
                            IsEnabled="{Binding IsStep1Complete, Converter={StaticResource InvertedBoolConverter}}" />
                    <Label Text="{Binding Step1Status}" FontSize="14" TextColor="{Binding Step1Status, Converter={StaticResource StringToColorConverter}}" />
                    <Border IsVisible="{Binding SelectedEquipment, Converter={StaticResource IsNotNullConverter}}"
                            Stroke="{StaticResource BorderColor}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 8"
                            Padding="10"
                            BackgroundColor="{StaticResource Surface}">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="{Binding SelectedEquipment.Name, StringFormat='Name: {0}'}" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource OnBackground}" />
                            <Label Text="{Binding SelectedEquipment.QRCode, StringFormat='QR: {0}'}" FontSize="13" TextColor="{StaticResource Gray300}" />
                            <Label Text="{Binding SelectedEquipment.Type, StringFormat='Type: {0}'}" FontSize="13" TextColor="{StaticResource Gray300}" />
                            <Label Text="{Binding SelectedEquipment.Status, StringFormat='Status: {0}'}" FontSize="13" TextColor="{Binding SelectedEquipment.Status, Converter={StaticResource StatusToColorConverter}}" />
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>
            </Border>

            <!-- Step 2: Handover From -->
            <Border Style="{StaticResource CardStyle}" Padding="10"
                    IsVisible="{Binding SelectedEquipment, Converter={StaticResource IsNotNullConverter}}">
                <VerticalStackLayout Spacing="8">
                    <Grid ColumnDefinitions="Auto, *">
                        <Label Text="2" FontSize="20" FontAttributes="Bold" TextColor="{StaticResource PrimaryColor}" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="Handover From" FontAttributes="Bold" FontSize="16" TextColor="{StaticResource PrimaryColor}" />
                    </Grid>
                    <Label Text="Current custodian (automatically set to you)." FontSize="13" TextColor="{StaticResource Gray300}" />
                    <Border BackgroundColor="{StaticResource Surface}" Padding="10" StrokeThickness="0">
                        <Label Text="{Binding CurrentUserFullName}" FontSize="14" TextColor="{StaticResource OnBackground}" />
                    </Border>
                    <Label Text="✅ Step 2 complete" FontSize="14" TextColor="{StaticResource SuccessColor}" />
                </VerticalStackLayout>
            </Border>

            <!-- Step 3: Handover To -->
            <Border Style="{StaticResource CardStyle}" Padding="10"
                    IsVisible="{Binding SelectedEquipment, Converter={StaticResource IsNotNullConverter}}">
                <VerticalStackLayout Spacing="8">
                    <Grid ColumnDefinitions="Auto, *">
                        <Label Text="3" FontSize="20" FontAttributes="Bold" TextColor="{StaticResource PrimaryColor}" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="Handover To" FontAttributes="Bold" FontSize="16" TextColor="{StaticResource PrimaryColor}" />
                    </Grid>
                    <Picker Title="Select Personnel"
                            ItemsSource="{Binding PersonnelList}"
                            ItemDisplayBinding="{Binding FullName}"
                            SelectedItem="{Binding SelectedPersonnel}"
                            TextColor="{StaticResource OnBackground}"
                            TitleColor="{StaticResource Gray300}"
                            BackgroundColor="{StaticResource Surface}" />
                    <Label Text="{Binding Step3Status}" FontSize="14" TextColor="{Binding Step3Status, Converter={StaticResource StringToColorConverter}}" />
                </VerticalStackLayout>
            </Border>

            <!-- Step 4: Confirm Transfer -->
            <Border Style="{StaticResource CardStyle}" Padding="10"
                    IsVisible="{Binding CanTransfer}">
                <VerticalStackLayout Spacing="8">
                    <Grid ColumnDefinitions="Auto, *">
                        <Label Text="4" FontSize="20" FontAttributes="Bold" TextColor="{StaticResource PrimaryColor}" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="Dual Confirmation" FontAttributes="Bold" FontSize="16" TextColor="{StaticResource PrimaryColor}" />
                    </Grid>
                    <Button Text="✅ Both Parties Confirm"
                            Style="{StaticResource SuccessButton}"
                            Command="{Binding ConfirmTransferCommand}" />
                </VerticalStackLayout>
            </Border>

            <ActivityIndicator IsRunning="{Binding IsBusy}" Color="{StaticResource PrimaryColor}" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>