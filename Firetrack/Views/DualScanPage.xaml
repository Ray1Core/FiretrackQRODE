<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Firetrack.Views.DualScanPage"
             Title="Dual‑Scan Handshake"
             BackgroundColor="{StaticResource Background}"
             Shell.TabBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">

            <!-- Header -->
            <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                <Label Text="🔄 Dual‑Scan Handshake"
                       FontSize="28"
                       FontAttributes="Bold"
                       TextColor="{StaticResource PrimaryColor}"
                       HorizontalOptions="Center" />
                <Label Text="Step 1: Admin → Step 2: Personnel → Step 3: Equipment"
                       FontSize="14"
                       TextColor="{StaticResource Gray300}"
                       HorizontalOptions="Center" />
            </VerticalStackLayout>

            <!-- Step 1: Admin Scan -->
            <Border Style="{StaticResource CardStyle}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Step 1: Admin Verification"
                           FontAttributes="Bold"
                           FontSize="16"
                           TextColor="{StaticResource PrimaryColor}" />
                    <Label Text="{Binding ScanStatus}" 
                           FontSize="14"
                           TextColor="{Binding ScanStatus, Converter={StaticResource StringToColorConverter}}" />
                    <Button Text="📷 Scan Admin QR"
                            Command="{Binding ScanAdminCommand}"
                            Style="{StaticResource PrimaryButton}"
                            IsEnabled="{Binding IsAdminScanComplete, Converter={StaticResource InvertedBoolConverter}}" />
                    <Label Text="{Binding AdminUsername, StringFormat='Admin: {0}'}"
                           FontSize="14"
                           TextColor="{StaticResource SuccessColor}"
                           IsVisible="{Binding IsAdminScanComplete}" />
                </VerticalStackLayout>
            </Border>

            <!-- Step 2: Personnel Scan -->
            <Border Style="{StaticResource CardStyle}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Step 2: Personnel Verification"
                           FontAttributes="Bold"
                           FontSize="16"
                           TextColor="{StaticResource PrimaryColor}" />
                    <Button Text="📷 Scan Personnel QR"
                            Command="{Binding ScanPersonnelCommand}"
                            Style="{StaticResource PrimaryButton}"
                            IsEnabled="{Binding IsAdminScanComplete}" />
                    <Label Text="{Binding PersonnelUsername, StringFormat='Personnel: {0}'}"
                           FontSize="14"
                           TextColor="{StaticResource SuccessColor}"
                           IsVisible="{Binding IsPersonnelScanComplete}" />
                </VerticalStackLayout>
            </Border>

            <!-- Step 3: Equipment Scan -->
            <Border Style="{StaticResource CardStyle}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Step 3: Equipment Verification"
                           FontAttributes="Bold"
                           FontSize="16"
                           TextColor="{StaticResource PrimaryColor}" />
                    <Button Text="📷 Scan Equipment QR"
                            Command="{Binding ScanEquipmentCommand}"
                            Style="{StaticResource PrimaryButton}"
                            IsEnabled="{Binding IsPersonnelScanComplete}" />
                    <Label Text="{Binding SelectedEquipment.Name, StringFormat='Equipment: {0}'}"
                           FontSize="14"
                           TextColor="{StaticResource SuccessColor}"
                           IsVisible="{Binding SelectedEquipment, Converter={StaticResource IsNotNullConverter}}" />
                </VerticalStackLayout>
            </Border>

            <!-- Confirm Transfer -->
            <Button Text="✅ Confirm Transfer"
                    Style="{StaticResource SuccessButton}"
                    Command="{Binding ConfirmTransferCommand}"
                    IsEnabled="{Binding SelectedEquipment, Converter={StaticResource IsNotNullConverter}}" />

            <!-- Reset -->
            <Button Text="🔄 Reset"
                    Style="{StaticResource SecondaryButton}"
                    Command="{Binding ResetCommand}" />

            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               Color="{StaticResource PrimaryColor}" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>