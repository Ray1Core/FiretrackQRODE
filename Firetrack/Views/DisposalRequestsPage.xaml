<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Firetrack.Views.DisposalRequestsPage"
             Title="Disposal Requests"
             BackgroundColor="{StaticResource Background}"
             Shell.TabBarIsVisible="False">

    <Grid RowDefinitions="Auto, *">
        <VerticalStackLayout Grid.Row="0" Padding="20" Spacing="10" BackgroundColor="{StaticResource PrimaryColor}">
            <Label Text="🗑️ Disposal Requests"
                   FontSize="24"
                   FontAttributes="Bold"
                   TextColor="White"
                   HorizontalOptions="Center" />
            <Label Text="Approve or reject equipment disposal requests."
                   FontSize="14"
                   TextColor="#E0E0E0"
                   HorizontalOptions="Center" />
        </VerticalStackLayout>

        <RefreshView Grid.Row="1" IsRefreshing="{Binding IsBusy}" Command="{Binding LoadRequestsCommand}">
            <VerticalStackLayout Padding="20" Spacing="15">
                <Label Text="{Binding StatusMessage}"
                       FontSize="14"
                       TextColor="{Binding StatusMessage, Converter={StaticResource StringToColorConverter}}"
                       HorizontalOptions="Center" />

                <CollectionView ItemsSource="{Binding PendingRequests}"
                                SelectionMode="Single"
                                SelectedItem="{Binding SelectedRequest}"
                                EmptyView="No pending disposal requests.">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CardStyle}" Margin="0,5" Padding="10">
                                <VerticalStackLayout Spacing="6">
                                    <Grid ColumnDefinitions="*, Auto">
                                        <Label Text="{Binding Name}" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource OnBackground}" />
                                        <Label Grid.Column="1" Text="{Binding QRCode}" FontSize="12" TextColor="{StaticResource Gray300}" />
                                    </Grid>
                                    <Label Text="{Binding Type, StringFormat='Type: {0}'}" FontSize="13" TextColor="{StaticResource Gray300}" />
                                    <Label Text="{Binding DisposalReason, StringFormat='Reason: {0}'}" FontSize="13" TextColor="{StaticResource OnBackground}" />
                                    <Label Text="{Binding DisposalRequestedBy, StringFormat='Requested by: {0}'}" FontSize="12" TextColor="{StaticResource Gray300}" />
                                    <Label Text="{Binding DisposalRequestDate, StringFormat='Requested: {0:MMM dd, yyyy HH:mm}'}" FontSize="12" TextColor="{StaticResource Gray300}" />
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <Grid ColumnDefinitions="*, *" ColumnSpacing="10" IsVisible="{Binding SelectedRequest, Converter={StaticResource IsNotNullConverter}}">
                    <Button Text="✅ Approve"
                            Style="{StaticResource SuccessButton}"
                            Command="{Binding ApproveCommand}"
                            CommandParameter="{Binding SelectedRequest}" />
                    <Button Grid.Column="1"
                            Text="❌ Reject"
                            Style="{StaticResource DangerButton}"
                            Command="{Binding RejectCommand}"
                            CommandParameter="{Binding SelectedRequest}" />
                </Grid>

                <Button Text="📄 Generate Certificate (Approved Only)"
                        Style="{StaticResource PrimaryButton}"
                        Command="{Binding GenerateCertificateCommand}"
                        CommandParameter="{Binding SelectedRequest}"
                        IsVisible="{Binding SelectedRequest, Converter={StaticResource IsNotNullConverter}}" />

                <ActivityIndicator IsRunning="{Binding IsBusy}" Color="{StaticResource PrimaryColor}" />
            </VerticalStackLayout>
        </RefreshView>
    </Grid>
</ContentPage>