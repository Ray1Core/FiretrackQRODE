<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Firetrack.Views.RequestEquipmentPage"
             Title="Request Equipment"
             BackgroundColor="{StaticResource Background}"
             Shell.TabBarIsVisible="False">

    <Grid RowDefinitions="Auto, *">

        <!-- Header -->
        <VerticalStackLayout Grid.Row="0" Padding="20" Spacing="10" BackgroundColor="{StaticResource PrimaryColor}">
            <Label Text="📋 Request Equipment"
                   FontSize="24"
                   FontAttributes="Bold"
                   TextColor="White"
                   HorizontalOptions="Center" />
            <Label Text="Tap an item to view details and request."
                   FontSize="14"
                   TextColor="#E0E0E0"
                   HorizontalOptions="Center" />
        </VerticalStackLayout>

        <!-- Equipment List (clean, tap to request) -->
        <RefreshView Grid.Row="1" IsRefreshing="{Binding IsBusy}" Command="{Binding LoadAvailableCommand}">
            <CollectionView ItemsSource="{Binding AvailableEquipment}"
                            SelectionMode="None"
                            EmptyView="No available equipment.">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardStyle}" Margin="10,5" Padding="10">
                            <Grid ColumnDefinitions="*, Auto" RowDefinitions="Auto, Auto, Auto, Auto">

                                <!-- Name -->
                                <Label Grid.Row="0" Grid.Column="0"
                                       Text="{Binding Name}"
                                       FontSize="16"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource OnBackground}" />
                                <!-- QR Code -->
                                <Label Grid.Row="0" Grid.Column="1"
                                       Text="{Binding QRCode}"
                                       FontSize="12"
                                       TextColor="{StaticResource Gray300}" />

                                <!-- Type -->
                                <Label Grid.Row="1" Grid.Column="0"
                                       Text="{Binding Type, StringFormat='Type: {0}'}"
                                       FontSize="13"
                                       TextColor="{StaticResource Gray300}" />

                                <!-- Status -->
                                <Label Grid.Row="2" Grid.Column="0"
                                       Text="{Binding Status}"
                                       FontSize="13"
                                       TextColor="White"
                                       Padding="6,2"
                                       Margin="0,4,0,0"
                                       HorizontalOptions="Start"
                                       HorizontalTextAlignment="Start"
                                       BackgroundColor="{Binding Status, Converter={StaticResource StatusToColorConverter}}" />

                                <!-- Assigned To (should be None for available) -->
                                <Label Grid.Row="3" Grid.Column="0"
                                       Text="{Binding AssignedToUsername, StringFormat='Assigned to: {0}'}"
                                       FontSize="12"
                                       TextColor="{StaticResource Gray300}" />

                                <!-- Tap gesture -->
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.ItemTappedCommand}"
                                                          CommandParameter="{Binding .}" />
                                </Grid.GestureRecognizers>

                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

    </Grid>
</ContentPage>